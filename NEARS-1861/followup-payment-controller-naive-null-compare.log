  double? get maxCodAmount {
    double? maximumCodOrderAmount;
    zoneLoop:
    for(ZoneData zData in AddressHelper.getUserAddressFromSharedPref()!.zoneData!) {
      for(Modules m in zData.modules!) {
        if(m.id == Get.find<ModuleController>().module?.id) {
          maximumCodOrderAmount = m.pivot!.maximumCodOrderAmount;
          break zoneLoop;
        }
      }
    }
    return maximumCodOrderAmount;
  }

This is the exact naive-nullable-comparison that NEARS-1861's OWN test file
(UserApp/test/features/favourite/favourite_module_id_filter_test.dart) documents as a
