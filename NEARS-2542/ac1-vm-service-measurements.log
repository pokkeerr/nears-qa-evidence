     strike=44.78 (RenderParagraph#2c234, flex=1,  constraints 0<=w<=1.0,  size 1.0x16.0)
     -- creator chain: Row <- LayoutBuilder <- _IntrinsicSizeProbe <- ... <- NItemCard
     -- THIS is the exact item flagged in the original QA FAIL pass; live-reproduced here
        as NEARS-2564 (pre-existing), not NEARS-2542.

