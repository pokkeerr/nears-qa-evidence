               -> DEV_NEW_TIP "dev: unrelated later change" (Admin/DevOnlyLater.php)
               -- development moves FORWARD after the feature branch forks (the
               "stale relative to development" condition in AC1).
  pr_repo (cloned from origin.git, feature/long-lived branched off DEV_OLD_TIP):
    DEV_OLD_TIP
