Admin/app/Http/Controllers/HomeController.php:438
  abort_unless(auth('admin')->check() || auth('vendor')->check() || auth('vendor_employee')->check(), 403);
Route: Admin/routes/web.php:46  GET deliveryman-earning-report-invoice/{id}  (web, session-auth only)
