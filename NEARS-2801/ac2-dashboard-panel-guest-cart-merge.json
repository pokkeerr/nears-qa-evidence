{
  "id": "panel_guest_cart_merge_rejections",
  "type": "line",
  "title": "Guest cart merge rejections by reason",
  "description": "NEARS-2801: guest.cart.merge.rejected counter (GuestTokenGuard), split by reason (invalid_guest_id / unknown_guest / legacy_null_token_strict / token_mismatch). Metrics stream naming follows the OTLP ingestion convention documented above the panels JSON in README.md \u2014 verify against the live stream once populated.",
  "config": {
    "show_legends": true,
