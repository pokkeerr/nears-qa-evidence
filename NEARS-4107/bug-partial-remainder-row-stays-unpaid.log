# regression candidate (pre-existing, NOT caused by NEARS-4107): Admin offline-payment verify leaves the partial order's offline remainder order_payments row UNPAID
# Mechanism: Admin/OrderController::offline_payment (~:2113) only marks unpaid order_payments rows paid when order.payment_method == 'partial_payment', but Api/V1/OrderController::offline_payment (:1037) flips the method to 'offline_payment' at customer submit, so the branch never runs for a submitted partial order.
# Live (QA DB multi_food_db_qa4107, order B2=91818, B3=91819, B4=91820, all staged via real routes):
 customer submits offline info B2: HTTP 200 {'payment': 'success'} -> status=pending method=offline_payment payment_status=partially_paid offline_rows=[{'status': 'pending'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
 admin verify B2: HTTP 302 -> status=confirmed payment_status=paid offline=[{'status': 'verified'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
 customer submits offline info B3: HTTP 200 {'payment': 'success'} -> status=pending method=offline_payment payment_status=partially_paid offline_rows=[{'status': 'pending'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
 admin verify B3: HTTP 302 -> status=confirmed payment_status=paid offline=[{'status': 'verified'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
 customer submits offline info B4: HTTP 200 {'payment': 'success'} -> status=pending method=offline_payment payment_status=partially_paid offline_rows=[{'status': 'pending'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
 admin verify B4: HTTP 302 -> status=confirmed payment_status=paid offline=[{'status': 'verified'}] payments=[{'payment_status': 'paid', 'payment_method': 'wallet'}, {'payment_status': 'unpaid', 'payment_method': 'offline_payment'}]
